/*
  D11-N 후속 상자 개봉 화면 스타일. Crafting.uss와 같은 방식 — .landscape 클래스가 붙으면
  (가로/태블릿) 세 줄을 두 칸씩 배치한다(row-list를 flex-wrap: row로). 결과 카드는 항상 한 칸,
  줄 아래에 그대로 남는다.
*/

.lootbox-root {
    flex-grow: 1;
    background-color: rgb(18, 18, 24);
    padding: 20px;
}

.lootbox-title {
    color: rgb(235, 235, 240);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.row-list {
    flex-direction: column;
}

.lootbox-root.landscape .row-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.box-row {
    background-color: rgb(30, 34, 48);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.lootbox-root.landscape .box-row {
    flex-basis: 30%;
    margin-right: 12px;
}

.row-name {
    color: rgb(235, 235, 240);
    font-size: 16px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.row-state {
    color: rgb(150, 160, 190);
    font-size: 13px;
    margin-right: 8px;
}

.row-button {
    height: 36px;
    min-width: 90px;
    font-size: 14px;
}

.result-card {
    background-color: rgb(24, 26, 36);
    border-radius: 8px;
    padding: 14px;
    margin-top: 4px;
}

.result-label {
    color: rgb(210, 200, 90);
    font-size: 14px;
    white-space: normal;
}
