<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="CargoFull.uss" />
    <!--
      M-04 화물칸 상한 도달 화면. docs/design/monetization.md "처음 상한에 닿았을 때 띄우는 화면은
      '멈췄습니다'가 아니라 '정제로 돌리시겠어요?'다. 무료 해법을 먼저 보여 주고, 상점은 그다음이다."
      상점 화면(M-07)은 아직 없어서 이 버전은 무료 해법(레이스로 제련소를 딴다)만 보여준다 —
      CargoFullPanel.cs가 MiningController.CargoJustFilled를 보고 여닫고, 제련소 레벨에 따라
      message-label 문구를 바꾼다. OfflineReward.uxml과 같은 가운데 카드 구성이라 .landscape
      분기가 따로 없다.
    -->
    <ui:VisualElement name="cargo-full-root" class="cargo-full-root">
        <ui:VisualElement name="cargo-full-card" class="cargo-full-card">
            <ui:Label text="정제로 돌리시겠어요?" class="cargo-full-title" />
            <ui:Label text="—" name="cargo-full-message" class="cargo-full-message" />
            <ui:VisualElement name="button-row" class="cargo-full-button-row">
                <ui:Button text="레이스 나가기" name="race-button" class="cargo-full-button cargo-full-button-primary" />
                <ui:Button text="닫기" name="close-button" class="cargo-full-button" />
            </ui:VisualElement>
            <!-- M-07: 상점 화면이 생겨서 두 번째 줄에 추가한다. 위 button-row와 달리 강조하지
                 않는다 — monetization.md "무료 해법을 상점보다 먼저 보여준다"대로 레이스 나가기가
                 여전히 1순위 버튼이다. -->
            <ui:Button text="상점 보기" name="shop-button" class="cargo-full-button cargo-full-button-secondary" />
            <!-- M-09 후속: 광고 보고 1시간 상한 2배. CargoFullPanel.cs가 오늘 한도·지금 켜진 중인지에
                 따라 ad-button/ad-label 중 하나만 보여준다. -->
            <ui:Label text="—" name="ad-label" class="cargo-full-ad-label" />
            <ui:Button text="광고 보고 1시간 상한 2배" name="ad-button" class="cargo-full-button cargo-full-button-secondary" />
            <!-- M-08: 첫 상한 도달 직후에만(MiningController.ShouldShowStarterPackOffer) 한 번 더
                 나오는 스타터 팩 칸. shop-button과 달리 CargoFullPanel.cs가 display를 직접
                 토글한다 — 두 번째, 세 번째... 상한 도달에는 안 보인다(사거나 거절할 때까지). -->
            <ui:VisualElement name="starter-pack-callout" class="starter-pack-callout">
                <ui:Label text="—" name="starter-pack-message" class="starter-pack-message" />
                <ui:VisualElement name="starter-pack-button-row" class="cargo-full-button-row">
                    <ui:Button text="스타터 팩 보기" name="starter-pack-button" class="cargo-full-button cargo-full-button-primary" />
                    <ui:Button text="괜찮아요" name="starter-pack-decline-button" class="cargo-full-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
