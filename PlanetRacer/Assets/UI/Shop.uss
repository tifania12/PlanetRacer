/*
  M-07 상점 화면 스타일. LootBox.uss와 같은 톤(어두운 배경, 카드형 줄)이지만 아홉 줄이라
  줄 패딩·글자 크기를 LootBox보다 조금 줄였다. .landscape(가로/태블릿)에서 두 칸으로
  재배치한다(CLAUDE.md 6번 규칙) — row-list를 flex-wrap: row로 바꾸고 줄 너비를 48%로.
*/

.shop-root {
    flex-grow: 1;
    background-color: rgb(18, 18, 24);
    padding: 20px;
}

.shop-title {
    color: rgb(235, 235, 240);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.row-list {
    flex-direction: column;
    flex-grow: 1;
}

.shop-root.landscape .row-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.shop-row {
    background-color: rgb(30, 34, 48);
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.shop-root.landscape .shop-row {
    flex-basis: 48%;
    margin-right: 8px;
}

.row-name {
    color: rgb(235, 235, 240);
    font-size: 14px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.row-state {
    color: rgb(150, 160, 190);
    font-size: 12px;
    margin-right: 8px;
    white-space: normal;
    max-width: 40%;
}

.row-button {
    height: 32px;
    min-width: 96px;
    font-size: 13px;
}

.shop-close-button {
    height: 40px;
    margin-top: 8px;
    font-size: 14px;
}
