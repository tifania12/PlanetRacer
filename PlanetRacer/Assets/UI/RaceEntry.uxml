<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="RaceEntry.uss" />
    <!--
      D09-N 레이스 출전 화면. 쿼츠 로컬 레이스 3개 — RaceEntryPanel.cs가
      DefaultData.QuartzCourses() 선언 순서와 그대로 매핑한다(코스 1/2/3).
      연료가 부족하면 출전 버튼이 비활성화된다. 출전하면 entry-view가 숨고
      anim-view(D10-N, 6대가 도착하는 연출)가 뜬 뒤 result-view로 넘어간다
      ("닫기"를 누르면 다시 entry-view로). Crafting.uxml과 같은 방식 —
      CLAUDE.md 6번 규칙대로 세로 기준, .landscape에서 두 칸으로 재배치.
      anim-view의 6줄은 RaceSimulator.Run이 이미 순위순으로 정렬해 돌려주는
      results 순서 그대로 채워서(=1등 줄이 항상 위) 자리가 안 섞인다.
    -->
    <ui:VisualElement name="race-root" class="race-root">
        <ui:VisualElement name="entry-view" class="entry-view">
            <ui:Label text="레이스 출전" class="race-title" />
            <ui:Label text="연료 0/10" name="fuel-label" class="fuel-label" />
            <ui:VisualElement name="row-list" class="row-list">
                <ui:VisualElement name="row-course-1" class="race-row">
                    <ui:Label text="석영 평원 스프린트" name="course1-name" class="row-name" />
                    <ui:Label text="600m x1 · 평지70 험지20 부스트10" name="course1-info" class="row-info" />
                    <ui:Button text="출전" name="course1-button" class="row-button" />
                </ui:VisualElement>
                <ui:VisualElement name="row-course-2" class="race-row">
                    <ui:Label text="결정 능선 루프" name="course2-name" class="row-name" />
                    <ui:Label text="800m x1 · 평지40 험지50 부스트10" name="course2-info" class="row-info" />
                    <ui:Button text="출전" name="course2-button" class="row-button" />
                </ui:VisualElement>
                <ui:VisualElement name="row-course-3" class="race-row">
                    <ui:Label text="반사면 직선로" name="course3-name" class="row-name" />
                    <ui:Label text="500m x2 · 평지50 험지10 부스트40" name="course3-info" class="row-info" />
                    <ui:Button text="출전" name="course3-button" class="row-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- M-09 후속: 연료가 부족해 출전 버튼이 전부 비활성일 때만 RaceEntryPanel.cs가 보여준다. -->
            <ui:Label text="—" name="fuel-ad-label" class="ad-label" />
            <ui:Button text="광고 보고 연료 +3" name="fuel-ad-button" class="ad-button" />
        </ui:VisualElement>

        <ui:VisualElement name="anim-view" class="anim-view">
            <ui:Label text="레이스 진행 중" class="race-title" />
            <ui:VisualElement name="anim-list" class="anim-list">
                <ui:VisualElement name="anim-row-0" class="anim-row">
                    <ui:Label text="" name="anim-name-0" class="anim-name" />
                    <ui:VisualElement name="anim-track-0" class="anim-track">
                        <ui:VisualElement name="anim-fill-0" class="anim-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="anim-row-1" class="anim-row">
                    <ui:Label text="" name="anim-name-1" class="anim-name" />
                    <ui:VisualElement name="anim-track-1" class="anim-track">
                        <ui:VisualElement name="anim-fill-1" class="anim-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="anim-row-2" class="anim-row">
                    <ui:Label text="" name="anim-name-2" class="anim-name" />
                    <ui:VisualElement name="anim-track-2" class="anim-track">
                        <ui:VisualElement name="anim-fill-2" class="anim-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="anim-row-3" class="anim-row">
                    <ui:Label text="" name="anim-name-3" class="anim-name" />
                    <ui:VisualElement name="anim-track-3" class="anim-track">
                        <ui:VisualElement name="anim-fill-3" class="anim-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="anim-row-4" class="anim-row">
                    <ui:Label text="" name="anim-name-4" class="anim-name" />
                    <ui:VisualElement name="anim-track-4" class="anim-track">
                        <ui:VisualElement name="anim-fill-4" class="anim-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="anim-row-5" class="anim-row">
                    <ui:Label text="" name="anim-name-5" class="anim-name" />
                    <ui:VisualElement name="anim-track-5" class="anim-track">
                        <ui:VisualElement name="anim-fill-5" class="anim-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="건너뛰기" name="skip-button" class="skip-button" />
        </ui:VisualElement>

        <ui:VisualElement name="result-view" class="result-view">
            <ui:Label text="레이스 결과" class="race-title" />
            <ui:VisualElement name="result-list" class="result-list">
                <ui:Label text="" name="result-row-0" class="result-row" />
                <ui:Label text="" name="result-row-1" class="result-row" />
                <ui:Label text="" name="result-row-2" class="result-row" />
                <ui:Label text="" name="result-row-3" class="result-row" />
                <ui:Label text="" name="result-row-4" class="result-row" />
                <ui:Label text="" name="result-row-5" class="result-row" />
            </ui:VisualElement>
            <ui:Label text="" name="reward-label" class="reward-label" />
            <!-- M-09 후속: 상자를 받은 판(우승 + 등급 있음)에서 오늘 한도가 남아 있을 때만. -->
            <ui:Label text="—" name="box-ad-label" class="ad-label" />
            <ui:Button text="광고 보고 상자 1개 더" name="box-ad-button" class="ad-button" />
            <ui:Button text="닫기" name="close-button" class="close-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
