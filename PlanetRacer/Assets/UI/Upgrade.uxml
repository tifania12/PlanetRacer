<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Upgrade.uss" />
    <!--
      D05-N 채굴 장비 업그레이드 화면. 곡괭이(Tool)/화물칸(Cargo)/엔진(Engine) 세 줄 — 레벨,
      다음 효과, 비용, 버튼. UpgradePanel.cs가 MiningController의 MiningRig를 읽어서 채운다.
      CLAUDE.md 6번 규칙: 세로 기준으로 만들고 .landscape 클래스에서 두 칸으로 재배치한다
      (Root.uss/ResponsiveLayout.cs와 같은 방식).
    -->
    <ui:VisualElement name="upgrade-root" class="upgrade-root">
        <ui:Label text="채굴 장비 업그레이드" class="upgrade-title" />
        <ui:Label text="원석 0" name="currency-label" class="currency-label" />
        <ui:VisualElement name="row-list" class="row-list">
            <ui:VisualElement name="row-tool" class="upgrade-row">
                <ui:Label text="곡괭이 Lv.1" name="tool-level" class="row-level" />
                <ui:Label text="다음: —" name="tool-effect" class="row-effect" />
                <ui:Button text="업그레이드" name="tool-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-cargo" class="upgrade-row">
                <ui:Label text="화물칸 Lv.1" name="cargo-level" class="row-level" />
                <ui:Label text="다음: —" name="cargo-effect" class="row-effect" />
                <ui:Button text="업그레이드" name="cargo-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-engine" class="upgrade-row">
                <ui:Label text="엔진 Lv.1" name="engine-level" class="row-level" />
                <ui:Label text="다음: —" name="engine-effect" class="row-effect" />
                <ui:Button text="업그레이드" name="engine-button" class="row-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
