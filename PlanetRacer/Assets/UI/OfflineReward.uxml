<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="OfflineReward.uss" />
    <!--
      D07-N 오프라인 보상 화면. 앱을 다시 켰을 때(자리를 비운 뒤) MiningController가 Awake에서
      미리 계산해 둔 PendingOfflineReward를 그대로 보여준다 — 경과·인정·버린 시간, 획득 원석,
      획득 정제 광물(M-02), 발견한 보물 요약, "받기" 버튼 하나. OfflineRewardPanel.cs가 값을
      채우고, 보상이 없으면(첫 실행이거나 자리를 비운 지 얼마 안 됐으면) 화면 전체를 숨긴다.
      한 칸짜리 중앙 카드라 세로/가로에서 재배치할 게 없다 — Root.uss처럼 .landscape 분기가 없다.
    -->
    <ui:VisualElement name="offline-reward-root" class="offline-reward-root">
        <ui:VisualElement name="offline-reward-card" class="offline-reward-card">
            <ui:Label text="돌아온 것을 환영한다" class="offline-reward-title" />
            <ui:Label text="자리를 비운 시간: —" name="elapsed-label" class="offline-reward-row" />
            <ui:Label text="인정된 시간: —" name="counted-label" class="offline-reward-row" />
            <ui:Label text="—" name="wasted-label" class="offline-reward-row offline-reward-row-dim" />
            <ui:Label text="획득 원석: —" name="minerals-label" class="offline-reward-row" />
            <ui:Label text="획득 정제 광물: —" name="refined-label" class="offline-reward-row offline-reward-row-highlight" />
            <ui:Label text="—" name="treasure-label" class="offline-reward-row" />
            <ui:Button text="받기" name="claim-button" class="offline-reward-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
