/*
  D14-N 설정 화면 스타일. LootBox.uss와 같은 방식 — .landscape 클래스가 붙으면(가로/태블릿)
  두 줄을 두 칸씩 배치한다(row-list를 flex-wrap: row로).
*/

.settings-root {
    flex-grow: 1;
    background-color: rgb(18, 18, 24);
    padding: 20px;
}

.settings-title {
    color: rgb(235, 235, 240);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.row-list {
    flex-direction: column;
}

.settings-root.landscape .row-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.settings-row {
    background-color: rgb(30, 34, 48);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.settings-root.landscape .settings-row {
    flex-basis: 46%;
    margin-right: 12px;
}

.row-name {
    color: rgb(235, 235, 240);
    font-size: 16px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.row-button {
    height: 36px;
    min-width: 70px;
    font-size: 14px;
}

.fps-button {
    margin-left: 8px;
}

/* 지금 선택된 프레임 값(30 또는 60)을 눈에 띄게. SettingsPanel.cs가 매 프레임 맞는 쪽에만 붙인다. */
.fps-button.selected {
    background-color: rgb(90, 130, 220);
    color: rgb(255, 255, 255);
}
