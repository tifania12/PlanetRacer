<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Shop.uss" />
    <!--
      M-07 상점 화면. LootBox.uxml과 같은 구조(고정 아홉 줄, 이름/상태/버튼) — 목록·가격은
      DefaultData.ShopItems()에서 읽어 ShopPanel.cs가 채운다. 실제 결제 SDK(P3)가 붙기 전이라
      버튼을 누르면 바로 ShopPurchase.Apply가 실행되는 디버그 구매다 — 제목에 "테스트"를 박아
      실제 결제로 오해하지 않게 한다. 세로 기준, .landscape에서 두 칸으로 재배치(CLAUDE.md 6번).
    -->
    <ui:VisualElement name="shop-root" class="shop-root">
        <ui:Label text="상점 (테스트 구매)" class="shop-title" />
        <ui:VisualElement name="row-list" class="row-list">
            <ui:VisualElement name="row-starter" class="shop-row">
                <ui:Label text="스타터 팩" name="starter-name" class="row-name" />
                <ui:Label text="" name="starter-state" class="row-state" />
                <ui:Button text="구매" name="starter-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-cargo1" class="shop-row">
                <ui:Label text="화물칸 확장 1단계" name="cargo1-name" class="row-name" />
                <ui:Label text="" name="cargo1-state" class="row-state" />
                <ui:Button text="구매" name="cargo1-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-cargo2" class="shop-row">
                <ui:Label text="화물칸 확장 2단계" name="cargo2-name" class="row-name" />
                <ui:Label text="" name="cargo2-state" class="row-state" />
                <ui:Button text="구매" name="cargo2-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-cargo3" class="shop-row">
                <ui:Label text="화물칸 확장 3단계" name="cargo3-name" class="row-name" />
                <ui:Label text="" name="cargo3-state" class="row-state" />
                <ui:Button text="구매" name="cargo3-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-offlinecap" class="shop-row">
                <ui:Label text="오프라인 상한 연장" name="offlinecap-name" class="row-name" />
                <ui:Label text="" name="offlinecap-state" class="row-state" />
                <ui:Button text="구매" name="offlinecap-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-accel" class="shop-row">
                <ui:Label text="채굴 가속 패스" name="accel-name" class="row-name" />
                <ui:Label text="" name="accel-state" class="row-state" />
                <ui:Button text="구매" name="accel-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-season" class="shop-row">
                <ui:Label text="행성 통행증 구독" name="season-name" class="row-name" />
                <ui:Label text="" name="season-state" class="row-state" />
                <ui:Button text="구매" name="season-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-steam" class="shop-row">
                <ui:Label text="Steam 서포터 팩" name="steam-name" class="row-name" />
                <ui:Label text="" name="steam-state" class="row-state" />
                <ui:Button text="구매" name="steam-button" class="row-button" />
            </ui:VisualElement>
            <ui:VisualElement name="row-adremoval" class="shop-row">
                <ui:Label text="광고 제거" name="adremoval-name" class="row-name" />
                <ui:Label text="" name="adremoval-state" class="row-state" />
                <ui:Button text="구매" name="adremoval-button" class="row-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="닫기" name="close-button" class="shop-close-button" />
    </ui:VisualElement>
</ui:UXML>
