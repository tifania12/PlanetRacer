/*
  D08-N 부품 제작 화면 스타일. Upgrade.uss와 같은 방식 — .landscape 클래스가 붙으면(가로/태블릿)
  다섯 줄을 두 칸씩 배치한다(row-list를 flex-wrap: row로). 세로에서는 위에서 아래로 한 줄씩 쌓인다.
*/

.crafting-root {
    flex-grow: 1;
    background-color: rgb(18, 18, 24);
    padding: 20px;
}

.crafting-title {
    color: rgb(235, 235, 240);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.currency-label {
    color: rgb(200, 200, 80);
    font-size: 16px;
    margin-bottom: 16px;
}

.row-list {
    flex-direction: column;
}

.crafting-root.landscape .row-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.craft-row {
    background-color: rgb(30, 34, 48);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.crafting-root.landscape .craft-row {
    flex-basis: 30%;
    margin-right: 12px;
}

.row-name {
    color: rgb(235, 235, 240);
    font-size: 16px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.row-state {
    color: rgb(150, 160, 190);
    font-size: 13px;
    margin-right: 8px;
}

.row-button {
    height: 36px;
    min-width: 90px;
    font-size: 14px;
}
