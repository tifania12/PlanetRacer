<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Root.uss" />
    <!--
      W-03 반응형 골격. 실제 게임 화면이 아니라 자리 표시자다.
      viewport-area = 3D 뷰가 들어갈 자리, hud-area = UI가 들어갈 자리.
      세로(9:16)에서는 위/아래, 가로(넓어지면)에서는 왼쪽/오른쪽으로 재배치된다.
      배치는 Root.uss의 .portrait / .landscape 클래스가 맡고, 클래스는
      Assets/Scripts/UI/ResponsiveLayout.cs가 화면 크기를 보고 붙인다.
    -->
    <ui:VisualElement name="root" class="root">
        <ui:VisualElement name="viewport-area" class="viewport-area">
            <ui:Label text="3D 뷰 (자리 표시자)" class="viewport-label" />
        </ui:VisualElement>
        <ui:VisualElement name="hud-area" class="hud-area">
            <ui:VisualElement name="status-bar" class="status-bar">
                <ui:Label text="쿼츠 행성" name="planet-name" class="status-label" />
                <ui:Label text="광물 0" name="mineral-count" class="status-label" />
            </ui:VisualElement>
            <ui:VisualElement name="action-row" class="action-row">
                <ui:Button text="채굴" name="btn-mine" class="action-button" />
                <ui:Button text="제작" name="btn-craft" class="action-button" />
                <ui:Button text="레이스" name="btn-race" class="action-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
