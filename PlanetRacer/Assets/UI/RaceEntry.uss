/*
  D09-N 레이스 출전 화면 스타일. Crafting.uss와 같은 방식 — .landscape 클래스가 붙으면(가로/태블릿)
  세 줄을 두 칸씩 배치한다(row-list를 flex-wrap: row로). 세로에서는 위에서 아래로 한 줄씩 쌓인다.
  result-view는 기본적으로 숨겨 두고(RaceEntryPanel.cs가 display로 전환) entry-view와 자리를 겹친다.
*/

.race-root {
    flex-grow: 1;
    background-color: rgb(18, 18, 24);
    padding: 20px;
}

.race-title {
    color: rgb(235, 235, 240);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.fuel-label {
    color: rgb(120, 200, 235);
    font-size: 16px;
    margin-bottom: 16px;
}

.row-list {
    flex-direction: column;
}

.race-root.landscape .row-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.race-row {
    background-color: rgb(30, 34, 48);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 12px;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.race-root.landscape .race-row {
    flex-basis: 45%;
    margin-right: 12px;
}

.row-name {
    color: rgb(235, 235, 240);
    font-size: 16px;
    -unity-font-style: bold;
    flex-grow: 1;
    min-width: 140px;
}

.row-info {
    color: rgb(150, 160, 190);
    font-size: 12px;
    flex-basis: 100%;
    margin-top: 4px;
    margin-bottom: 8px;
}

.row-button {
    height: 36px;
    min-width: 90px;
    font-size: 14px;
}

.anim-view {
    display: none;
    flex-grow: 1;
}

.anim-list {
    flex-direction: column;
    margin-bottom: 16px;
}

.anim-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.anim-name {
    color: rgb(220, 220, 225);
    font-size: 14px;
    width: 70px;
}

/* cargo-gauge-track/fill(Root.uss)과 같은 패턴 — 도착 시각이 될수록 fill이 100%까지 찬다. */
.anim-track {
    flex-grow: 1;
    height: 14px;
    background-color: rgb(40, 42, 56);
    border-radius: 7px;
    overflow: hidden;
}

.anim-fill {
    height: 100%;
    width: 0%;
    background-color: rgb(120, 200, 140);
}

.skip-button {
    height: 36px;
    font-size: 14px;
    align-self: flex-end;
    min-width: 100px;
}

.result-view {
    display: none;
    flex-grow: 1;
}

.result-list {
    flex-direction: column;
    margin-bottom: 12px;
}

.result-row {
    color: rgb(220, 220, 225);
    font-size: 15px;
    background-color: rgb(30, 34, 48);
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 6px;
}

.reward-label {
    color: rgb(200, 200, 80);
    font-size: 15px;
    margin-bottom: 16px;
}

.close-button {
    height: 40px;
    font-size: 15px;
}
